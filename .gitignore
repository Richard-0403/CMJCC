# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Environment / secrets
.env
*.env
!.env.example

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Artifacts (generated run bundles, logs, indexes, CI/perf/data-quality output)
artifacts/runs/
artifacts/logs/
artifacts/indexes/
artifacts/reports/
artifacts/data_quality/
artifacts/ci-smoke/
# Hybrid connectivity-smoke run bundles and the official hybrid run logs. Same rule as
# the directories above: generated evidence lives on disk and ships with the thesis
# archive, not in git (the smoke tree alone is 268 files of run bundles).
artifacts/hybrid_smoke/
artifacts/p0_2_smoke/
artifacts/*.log

# OS
.DS_Store


# Evaluation raw run bundles + bulky regenerable normalized tables;
# keep report/metrics/plots/statistics/manifests/audit deliverables
# Run bundles AND the per-experiment analysis trees. Producing an official artifact used
# to leave an untracked directory behind, which made the NEXT official run record
# git_dirty=true even though its sources were identical -- so the flag stopped meaning
# "ran from modified code". The citable subset is committed under final_release/ instead.
evaluation/outputs/_runs/
evaluation/outputs/*/
# Long-term-memory validation set (evaluation/data/scenarios_longterm.jsonl). Same rule
# as the main experiment: the run bundles and regenerable tables stay on disk, the frozen
# INPUTS (the scenario file and its canonical oracle) are in version control, so the
# archive is reproducible from what is tracked.
evaluation/outputs_longterm/_runs/
evaluation/outputs_longterm/*/


# Hybrid (real-LLM) run outputs; the citable subset lives under final_release/hybrid/
evaluation/outputs_hybrid/


# Human-labelled analysis output. Same rule as the other experiment output trees: the run
# bundles are reused, not re-run, and the tree is regenerable from the tracked label files
# plus the sealed bundles.
evaluation/outputs_human/

# Draft output of scripts/build_eval_scenarios.py. Regenerable, and deliberately NOT the
# authoritative evaluation/data/scenarios.jsonl -- which that builder now refuses to write
# because it emits no `reference` declarations.
evaluation/data/scenarios_draft.jsonl

# Local archives of scratch directories. The annotation evidence package itself is tracked
# below, so a side archive adds nothing but bulk.
evaluation/*.rar

# NOTE: evaluation/annotation_workspace/ is deliberately NOT ignored. It is the auditable
# human-annotation evidence package -- rater-level labels, adjudicated gold, the rubric
# actually applied, claim text with its evidence, provenance and a checksum manifest.
# Ignoring only part of it would break its own self-verification, so it is tracked whole
# or not at all.


# final_release/ IS tracked: it is the slim, citable subset -- the reports, the metric and
# statistics tables, the plots, the manifests, the checksums and the provenance that the
# thesis actually references (about 1.4 MB). What stays out of it is the bulk that can be
# regenerated from the run bundles: the normalized tables and the bundles themselves.
# Those ship with the thesis as a standalone archive whose sha256 is recorded in
# final_release/provenance.json.
final_release/**/normalized/
final_release/*_runs/
