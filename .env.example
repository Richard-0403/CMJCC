# Copy to .env and adjust. Never commit real secrets.
# Secrets live ONLY here / in the environment - never in configs/*.yaml.

# PostgreSQL connection (SQLAlchemy + psycopg3 driver).
# Docker Compose provides a "postgres" service on this URL.
DATABASE_URL=postgresql+psycopg://jobrec:jobrec@localhost:5432/jobrec

# Set to 1 to make a reachable database mandatory (experiment/production runs
# already require one): an unreachable DB then fails fast, never falls back to
# in-memory storage.
# JOBREC_REQUIRE_DB=1

# Application
JOBREC_CONFIG=configs/experiment_full.yaml
JOBREC_CATALOG=data/processed/jobs.jsonl

# Config templates: configs/deterministic.yaml (no key needed, reproducible main
# result) and configs/hybrid.yaml (LLM-assisted path; offline with provider mock).

# LLM provider (only used in hybrid mode with provider: remote; deterministic and
# replay runs need no key). Startup validation fails fast if this is missing for a
# remote hybrid run. Example: Vector Engine (OpenAI-compatible), model gpt-5.5.
# JOBREC_LLM_API_KEY=<your-key-here>
# JOBREC_LLM_BASE_URL=https://api.vectorengine.ai/v1
# JOBREC_LLM_MODEL=gpt-5.5
