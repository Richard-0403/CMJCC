# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL connection (SQLAlchemy + psycopg3 driver).
# Docker Compose provides a "postgres" service on this URL.
DATABASE_URL=postgresql+psycopg://jobrec:jobrec@localhost:5432/jobrec

# Application
JOBREC_CONFIG=configs/experiment_full.yaml
JOBREC_CATALOG=data/processed/jobs.jsonl

# LLM provider (only used in hybrid mode; deterministic/replay need no key).
# JOBREC_LLM_API_KEY=
# JOBREC_LLM_BASE_URL=
# JOBREC_LLM_MODEL=
